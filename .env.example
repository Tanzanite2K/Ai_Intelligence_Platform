# ---- runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true

# ---- storage (docker-compose values; local default is SQLite ./data/platform.db)
DATABASE_URL=postgresql+asyncpg://aip:aip@postgres:5432/aip
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
NEO4J_URL=bolt://neo4j:7687
# Optional graph profile only; set a strong unique value (no default is accepted)
NEO4J_PASSWORD=

# ---- source credentials (optional but recommended)
# GitHub: required for >60 star lookups/hour (5,000/h with a token). Fine-grained token, public-repo read only.
GITHUB_TOKEN=
# Hugging Face read token (https://huggingface.co/settings/tokens) - avoids Hub API 429s
HF_TOKEN=
# Product Hunt developer token (https://api.producthunt.com/v2/oauth/applications)
PRODUCTHUNT_TOKEN=

# ---- LLM providers (fallback order: gemini -> groq -> deepseek)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
LLM_MAX_CONCURRENCY=16
GROQ_INPUT_TOKEN_BUDGET=6000
GEMINI_INPUT_TOKEN_BUDGET=24000
DEEPSEEK_INPUT_TOKEN_BUDGET=24000

# ---- crawling
USER_AGENT=FrontierAtlasBot/1.0 (+https://github.com/<you>/ai-intelligence-platform; contact: you@example.com)
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_PER_HOST=8
DEFAULT_DOMAIN_RPS=2.0
RESPECT_ROBOTS_TXT=true
FRESHNESS_WINDOW_HOURS=24

# ---- Google Sheets export (service account JSON; share the sheet or use --share-public)
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=
EXPORT_DIR=./data/exports

# ---- Web API (python -m src.main serve) -------------------------------------------------------
# Admin operations (crawl trigger) need this value in the X-Admin-Key header. Leave empty to DISABLE them.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# Browser origins allowed to call the API (the Next.js frontend). Comma-separated, no wildcard.
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Requests per minute per client IP on /api/v1 (0 = off)
API_RATE_LIMIT_PER_MINUTE=240
# Open SQLite read-only from the API process (recommended; the web tier never writes)
API_READ_ONLY=true
